# main.fk (game codebase games/redgreen): the red-green part of spm10's main, placed for routing.
#
# Same rows and counts as games/spm10/redgreen.fk; only the placement differs. Every row is
# counterflow with its attach points at its west head; the miners are turned 180 degrees (rot 2)
# so their ore belts also leave west. Columns 0..15 are a corridor the router owns, and bands of
# rows leave three-tile gaps between them. The router lays every net's belts; nothing here is a
# route.
iron_mine    = MinerRow<n=10, resource=iron-ore>   @(16, 0, rot 2)
coal_iron    = MinerRow<n=2, resource=coal>        @(34, 0, rot 2)
copper_mine  = MinerRow<n=4, resource=copper-ore>  @(40, 0, rot 2)
coal_copper  = MinerRow<n=1, resource=coal>        @(49, 0, rot 2)
iron_smelt   = SmelterRow<n=16, recipe=iron-plate>   @(16, 10)
copper_smelt = SmelterRow<n=6, recipe=copper-plate>  @(51, 10)

gears = AsmRow<n=3, recipe=iron-gear-wheel>          @(16, 20)
cable = AsmRow<n=4, recipe=copper-cable>             @(28, 20)
circ  = AsmRow<n=2, recipe=electronic-circuit>       @(43, 20)
belts = AsmRow<n=1, recipe=transport-belt>           @(52, 20)
ins   = AsmRow<n=1, recipe=inserter>                 @(58, 20)
red   = AsmRow<n=5, recipe=automation-science-pack>  @(16, 32)
green = AsmRow<n=6, recipe=logistic-science-pack>    @(34, 32)
labs  = LabRow<n=10>                                 @(16, 43)

net iron_ore:    iron_mine -> iron_smelt
net copper_ore:  copper_mine -> copper_smelt
net iron_fuel:   coal_iron -> iron_smelt
net copper_fuel: coal_copper -> copper_smelt
net iron:   iron_smelt -> gears, circ, belts, ins
net copper: copper_smelt -> cable, red
net gear:   gears -> red, belts, ins
net cable:  cable -> circ
net circ:   circ -> ins
net belt:   belts -> green
net ins_:   ins -> green
net packs:  red, green -> labs

assert red.rate >= 10/min
assert green.rate >= 10/min
