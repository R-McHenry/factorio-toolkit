# smelting.fk: iron ore and coal into plates, the plates into a provider chest for the robots.
# Plot: 26x26 (place smelting = smelting plot X,Y 26x26 in nauvis.surface), on an iron patch.
ore   = MinerRow<n=4, resource=iron-ore>   @(10, 2, rot 2)
coal  = MinerRow<n=2, resource=coal>       @(18, 2, rot 2)
smelt = SmelterRow<n=8, recipe=iron-plate> @(10, 12)
box   = Chest<provider, limit=4>           @(4, 22)

net ore_:   ore -> smelt
net fuel:   coal -> smelt
net plates: smelt -> box
