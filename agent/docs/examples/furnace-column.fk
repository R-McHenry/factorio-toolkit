# furnace-column.fk: electric furnaces as a stack of your own cells. Plot 31x41. A 7x3 cell of one
# electric furnace between an ore belt and a plate belt, with two productivity modules (modules=);
# Stack<cell=FurnaceCell, n=8> lines up eight; six drills feed it.
# Run:  fk rates furnace-column.fk    fk build --to report_checks
# Expect: the first five furnaces full (`iron-plate 36.45`), the sixth at a third, the last two
# `iron-ore short on col/0/o`: 3 ore/s is ore for 5.3 furnaces, served in belt order; `no-limit
# furnace-column box` (the provider has no limit=).
module FurnaceCell size 7x3 {
  port ore_in  : in  iron-ore   @s0
  port ore_out : out iron-ore   @n0
  port pl_in   : in  iron-plate @n6
  port pl_out  : out iron-plate @s6
  stack ore_in -> ore_out, pl_out -> pl_in
  f = Furnace<recipe=iron-plate, machine=electric-furnace, modules=productivity-module> @(2, 0)
  net o: ore_in -> f, ore_out
  net p: pl_in, f -> pl_out
}

ore = MinerRow<n=6, resource=iron-ore> @(19, 7, rot 2)
col = Stack<cell=FurnaceCell, n=8>     @(10, 12)
box = Chest<provider>                  @(30, 40)

net ore_:   ore -> col.ore_in
net plates: col.pl_out -> box
