# compact-mall.fk: a mall laid out the way Rory prescribed (2026-10-21): machines in rows, no gap
# between chains, a 1-tile gap inside a chain (that gap holds the one inserter that links a maker to
# what takes its output: no belt). Two rows face one 4-tile corridor (y 5..8) that carries the iron
# in and the products out. One iron net, one copper net and one products net into one chest
# (Rory: "one copper net and one products net, to save on logistics chests"): 1 provider chest
# instead of one per product, 172 route carriers in all (152 belts), 17 of its 20 nets single
# inserters.
#
# A maker whose product also feeds a neighbour stays on that link (a machine is on one net per item
# and direction), so the products belt gets its pipes and yellow belts from makers of their own
# (pipe, yb3). The products belt is sushi. The chest has no limit=: when a mixed belt's chest is
# full the whole belt stops, so a slot limit only brings that sooner (SUSHI_LIMIT). What keeps it
# from filling is a property on each maker's output hand (2.0.27): `set yu.out:
# logistic=underground-belt<50` waits while the logistic network holds 50; with one on every maker,
# `net products limited:` quiets CLOG.
#
# In a base the plates come from your smelting or a bus tap, not from these requesters: name your
# smelter row (or the tap) as the driver of `fe` and `cu`, and the router brings that belt to the
# corridor's middle (x 24) and to row B's underside (x 49, y 13).

# row A at y 2: belts and undergrounds, pipes and pipes-to-ground, splitters
ga     = Assembler<recipe=iron-gear-wheel>        @(2, 2)
yb     = Assembler<recipe=transport-belt>         @(6, 2)
yu     = Assembler<recipe=underground-belt> @(10, 2)
gx     = Assembler<recipe=iron-gear-wheel>        @(13, 2)
yb3    = Assembler<recipe=transport-belt> @(17, 2)
pipe   = Assembler<recipe=pipe>         @(20, 2)
pipe2  = Assembler<recipe=pipe>                   @(23, 2)
ptg    = Assembler<recipe=pipe-to-ground> @(27, 2)
gs     = Assembler<recipe=iron-gear-wheel>        @(30, 2)
yb2    = Assembler<recipe=transport-belt>         @(34, 2)
ys     = Assembler<recipe=splitter>      @(38, 2)
cs     = Assembler<recipe=electronic-circuit>     @(42, 2)
ks     = Assembler<recipe=copper-cable>           @(46, 2)

# row B at y 9: inserters, assemblers, drills; each circuit maker between its cable maker and the
# machine it feeds
gc     = Assembler<recipe=iron-gear-wheel>        @(2, 9)
ins    = Assembler<recipe=inserter>     @(6, 9)
cb     = Assembler<recipe=electronic-circuit>     @(10, 9)
kb     = Assembler<recipe=copper-cable>           @(14, 9)
gd     = Assembler<recipe=iron-gear-wheel>        @(17, 9)
asm    = Assembler<recipe=assembling-machine-1> @(21, 9)
cc     = Assembler<recipe=electronic-circuit>     @(25, 9)
kc     = Assembler<recipe=copper-cable>           @(29, 9)
ge     = Assembler<recipe=iron-gear-wheel>        @(32, 9)
drill  = Assembler<recipe=electric-mining-drill> @(36, 9)
cd     = Assembler<recipe=electronic-circuit>     @(40, 9)
kd     = Assembler<recipe=copper-cable>           @(44, 9)

# the one chest every product goes into, at the corridor's west end
box    = Chest<provider>                          @(0, 6)

# the plates in (stand-ins for the belts from your smelting)
fe     = Chest<requester, item=iron-plate, rate=4/s>     @(24, 6)
cu     = Chest<requester, item=copper-plate, rate=2/s>   @(49, 13)

net fe: fe -> ga, yb, yu, gx, yb3, pipe, pipe2, ptg, gs, yb2, ys, cs, gc, ins, cb, gd, asm, cc, ge, drill, cd
net cu: cu -> ks, kb, kc, kd
net products limited: yu, yb3, pipe, ptg, ys, ins, asm, drill -> box
net gao:  ga -> yb
net ybo:  yb -> yu
net gxo:  gx -> yb3
net p2o:  pipe2 -> ptg
net gso:  gs -> yb2
net yb2o: yb2 -> ys
net cso:  cs -> ys
net kso:  ks -> cs
net gco:  gc -> ins
net cbo:  cb -> ins
net kbo:  kb -> cb
net gdo:  gd -> asm
net cco:  cc -> asm
net kco:  kc -> cc
net geo:  ge -> drill
net cdo:  cd -> drill
net kdo:  kd -> cd

# one property per maker: its output hand waits on the network's count
set yu.out: logistic=underground-belt<50
set yb3.out: logistic=transport-belt<200
set pipe.out: logistic=pipe<100
set ptg.out: logistic=pipe-to-ground<50
set ys.out: logistic=splitter<20
set ins.out: logistic=inserter<100
set asm.out: logistic=assembling-machine-1<20
set drill.out: logistic=electric-mining-drill<20
