  net ridge_tap2_1_a items stone-brick: cw.ridge_tap2_o -> core.r_tap2
  net ridge_tap2_1_b items rail: cw.ridge_tap2_o -> core.r_tap2
  lanes ridge_tap2_1_a | ridge_tap2_1_b
  net ridge_tap3_0_a items electric-furnace: ridge.tap3 -> cw.ridge_tap3_i
  net ridge_tap3_0_b items stone: ridge.tap3 -> cw.ridge_tap3_i
  lanes ridge_tap3_0_a | ridge_tap3_0_b
  net ridge_tap3_1_a items electric-furnace: cw.ridge_tap3_o -> core.r_tap3
  net ridge_tap3_1_b items stone: cw.ridge_tap3_o -> core.r_tap3
  lanes ridge_tap3_1_a | ridge_tap3_1_b
}

flower = Flower @(0, 0)
