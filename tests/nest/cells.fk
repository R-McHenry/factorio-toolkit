# cells.fk for cells within cells (2.1): the parameterised FurnaceCell and the kickoff template's
# LabCell, and the two columns built of them.

# One electric furnace beside two belts: the ore runs up through every cell on the west belt, the
# plates come back down the east one.
module FurnaceCell<plate, ore> size 7x3 {
  port ore_in  : in  $ore   @s0
  port ore_out : out $ore   @n0
  port pl_in   : in  $plate @n6
  port pl_out  : out $plate @s6
  stack ore_in -> ore_out, pl_out -> pl_in
  f = Furnace<recipe=$plate, machine=electric-furnace> @(2, 0)
  net o: ore_in -> f, ore_out
  net p: pl_in, f -> pl_out
}

# A column of three FurnaceCells, the ore chained along its foot from west to east: stacked east,
# the columns stand side by side and the ore runs along all their feet. Each column's plates leave
# by its own port at the bottom.
module SmeltColumn<plate, ore> size 11x15 {
  port ore_in  : in  $ore | $ore @w12
  port ore_out : out $ore | $ore @e12
  port pl      : out $plate      @s9
  stack ore_in -> ore_out
  s = Stack<cell=FurnaceCell, n=3, plate=$plate, ore=$ore> @(3, 0)
  net o: ore_in -> s.ore_in, ore_out
  net p: s.pl_out -> pl
}

# One lab: red and green packs on the two lanes of one belt, which runs on to the next lab.
module LabCell size 5x3 {
  port p_in  : in  automation-science-pack | logistic-science-pack @s0
  port p_out : out automation-science-pack | logistic-science-pack @n0
  stack p_in -> p_out
  lab = Lab<rate=7/min> @(2, 0)    # logistics-2 on the lab: 30 s units at speed 3.5
  net r items automation-science-pack: p_in -> lab, p_out
  net g items logistic-science-pack:   p_in -> lab, p_out
  lanes r | g
}

# A column of six labs with a pack header across its bottom, chained east: a red belt and a green
# belt, each splitting off into the column, where they meet on the column's belt a lane each.
# Stacked east, the columns make a field and the packs run along all their headers.
module LabColumn size 9x24 {
  port r_in  : in  automation-science-pack @w20
  port r_out : out automation-science-pack @e20
  port g_in  : in  logistic-science-pack   @w22
  port g_out : out logistic-science-pack   @e22
  stack r_in -> r_out, g_in -> g_out
  labs = Stack<cell=LabCell, n=6> @(3, 0)
  net r: r_in -> labs.p_in, r_out
  net g: g_in -> labs.p_in, g_out
}
