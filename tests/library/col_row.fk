# col_row.fk: an electric SmelterRow of six on copper (2.1, the library; tools\lab_library.py measures it)
ore = Chest<requester, item=copper-ore> @(2, 2)
smelt = SmelterRow<n=6, ore=copper-ore, machine=electric-furnace> @(4, 8)
box = Chest<provider> @(8, 24)
net o: ore -> smelt
net p: smelt -> box
