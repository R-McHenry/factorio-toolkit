# steel_pair.fk: SmelterPair on steel (iron plates in) (2.1, the library; tools\lab_library.py measures it)
import SmelterPair from "cells.fk"
ore  = Chest<requester, item=iron-plate> @(4, 2)
coal = Chest<requester, item=coal> @(14, 2)
col  = Stack<cell=SmelterPair, n=4, plate=steel-plate, ore=iron-plate> @(10, 8)
box  = Chest<provider> @(16, 24)
net ore_: ore -> col.f_in
net fuel: coal -> col.f_in
lanes ore_ | fuel
net p: col.pw_out, col.pe_out -> box
