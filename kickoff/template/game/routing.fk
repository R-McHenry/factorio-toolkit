# routing.fk: small pieces that help the router, yours to change. Each one is a sealed module: its
# ports are where belts cross its edge, and its one net is laid inside it. Place one where you want
# a belt to go and split your net at it; the router then lays each half as a net of its own.
#
#   import Waypoint, Merge, Split from "routing.fk"
#
# A net the router can't find a way for: make it pass a spot of your choosing.
#
#   wp = Waypoint<item=iron-gear-wheel> @(8, 28)
#   net gear:  gears -> wp.i
#   net gear2: wp.o -> red, belts, ins
#
# Two belts into one, where you want the join (red packs on one lane, green on the other):
#
#   mg = Merge<a=automation-science-pack, b=logistic-science-pack> @(4, 40)
#   net pk_r:  red -> mg.a
#   net pk_g:  green -> mg.b
#   net packs: mg.o -> labs
#
# One belt into two, where you want the split:
#
#   sp = Split<item=copper-plate> @(4, 16)
#   net copper: copper_smelt -> sp.i
#   net cu_a:   sp.a -> cable
#   net cu_b:   sp.b -> red
#
# Each piece runs north to south (in at its top edge, out at its bottom); turn it with `rot`
# (@(x, y, rot 1) runs east to west, rot 3 west to east). Make your own the same way: ports on
# the edge, one net between them, as long or as wide as you like. docs\LANGUAGE.md, "Modules
# with ports", has the rules.

# One belt, three tiles long: the net passes here.
module Waypoint<item> size 1x3 {
  port i : in  $item @n0
  port o : out $item @s0
  net p: i -> o
}

# Two belts into one: a on one lane, b on the other (the same item twice: both lanes).
module Merge<a, b> size 2x3 {
  port a : in  $a @n0
  port b : in  $b @n1
  port o : out $a | $b @s0
  net p: a, b -> o
}

# One belt into two, by a splitter.
module Split<item> size 2x3 {
  port i : in  $item @n0
  port a : out $item @s0
  port b : out $item @s1
  net p: i -> a, b
}
