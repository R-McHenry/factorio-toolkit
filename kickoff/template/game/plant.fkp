fkp 1 factory plant
size 16x15
inst reactor Literal box=-34,-39,-17,-23 file=plant-w3.json at 0,0 rot 0 sig d331f54097
cover power power pole=medium-electric-pole
e reactor/heat-exchanger0 heat-exchanger 9,8.5 E
e reactor/inserter0 inserter 2.5,6.5 E net=reactor/hand0
e reactor/inserter1 inserter 2.5,7.5 W net=reactor/hand1 config='{"control_behavior":{"circuit_condition":{"comparator":"<","constant":550,"first_signal":{"name":"signal-T","type":"virtual"}},"circuit_enabled":true}}' wire=1,nuclear-reactor0,1
e reactor/iron-chest0 iron-chest 1.5,6.5 N
e reactor/medium-electric-pole0 medium-electric-pole 5.5,5.5 N
e reactor/medium-electric-pole1 medium-electric-pole 10.5,10.5 N
e reactor/nuclear-reactor0 nuclear-reactor 5.5,8.5 N config='{"control_behavior":{"read_temperature":true,"temperature_signal":{"name":"signal-T","type":"virtual"}}}'
e reactor/offshore-pump0 offshore-pump 8.5,1.5 N
e reactor/pipe0 pipe 8.5,2.5 N net=reactor/fluid0
e reactor/pipe1 pipe 8.5,3.5 N net=reactor/fluid0
e reactor/pipe2 pipe 8.5,4.5 N net=reactor/fluid0
e reactor/pipe3 pipe 8.5,5.5 N net=reactor/fluid0
e reactor/pipe4 pipe 8.5,6.5 N net=reactor/fluid0
e reactor/pipe5 pipe 10.5,6.5 N net=reactor/fluid1
e reactor/pipe6 pipe 10.5,7.5 N net=reactor/fluid1
e reactor/pipe7 pipe 10.5,8.5 N net=reactor/fluid1
e reactor/pipe8 pipe 10.5,9.5 N net=reactor/fluid1
e reactor/requester-chest0 requester-chest 1.5,7.5 N config='{"request_filters":{"sections":[{"filters":[{"comparator":"=","count":20,"index":1,"max_count":50,"name":"uranium-fuel-cell","quality":"normal"}],"index":1}],"trash_not_requested":true}}'
e reactor/roboport0 roboport 12,13 N config='{"request_filters":{"sections":[{"index":1}]}}'
e reactor/steam-turbine0 steam-turbine 13.5,6.5 E
e reactor/steam-turbine1 steam-turbine 13.5,9.5 E
