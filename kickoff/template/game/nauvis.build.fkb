# the default flow (CORE-V1.md §7); keep it or tweak it. One contained tool per line; each reads
# what the steps before it left and writes out/<step>.txt, and a layout step out/<step>/*.fkp.
read_surface    nauvis                    # surface file: factories, plots, claims, mode, policy
read_terrain    map                       # the bare world: ore, water, cliffs (map.terrain.json)
run_models      --stale                   # model scripts: derive and pin parameters
elaborate                                 # templates -> logical netlist + its checks
size                                      # n=auto rows: the fewest machines for the targets, asserts and consumers (out/size.txt)
report_rates                              # nominal rate model, asserts, surface targets
place           --keep pinned             # fragments by their @(x, y) hints; Literals stay
route           --only stale --effort normal --hand any   # direct insertion: the lowest hand the network can build (out/avail.json, which falls back to the lowest it can make)
hands           minimize                  # every short hand: that lowest rung, raised only where the routed flow needs more (out/hands.txt; "hands maximize" takes the top rung everywhere)
tier            minimize --allow yellow   # belt tier per lane: --allow yellow,red for red where yellow is too thin; --red N caps it
report_rates                              # again, routed: the lanes and inserters as laid (CAPACITY)
cover robots                              # roboports over the logistic chests (before power)
cover power     --pole any                # medium poles where the network can build them, else small: the coverage step picks (no ghost the network cannot build)
floorplan                                 # the plot composed: one surface, one owner of every tile
report_checks                             # invariants + warnings, connectivity of every net
diff            --scope stale             # what stands there now, against the design (the game)
report_bom      --stock live              # still to build vs the network's stock and research (LOW_STOCK, LOCKED)
write_layout                              # write the .fkp files: the design the next build keeps to (--to diff writes nothing)
apply           --scope stale             # the paste: ghosts, robots build them (the game)
stop_on         invariant                 # the default: only malformed data stops the run
stop_on         UNROUTED NO_SINK          # and no paste with a net unrouted, or a maker whose product reaches no sink
